# KnightVerse root environment example
# Copy to .env and adjust values for local development.

# --- Core data stores (docker compose) ---
POSTGRES_USER=knightverse
POSTGRES_PASSWORD=knightverse_password
POSTGRES_DB=knightverse_db

# --- Monitoring profile (optional) ---
# Required only when starting Prometheus/Grafana:
#   docker compose --profile monitoring up -d
# or:
#   docker compose -f backend/docker-compose.monitoring.yml --project-directory backend up -d
#
# A default of "knightverse" is used when unset. Override in production.
GRAFANA_ADMIN_PASSWORD=changeme
