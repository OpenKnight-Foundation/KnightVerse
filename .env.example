# =============================================================================
# KnightVerse root environment example
#
# Copy to .env and adjust values for local development:
#   cp .env.example .env
#   docker compose up -d
#
# docker compose reads .env automatically for ${VAR} substitution in
# docker-compose.yml. Values shown here are safe local-development defaults;
# override secrets (JWT_SECRET, POSTGRES_PASSWORD) for anything beyond local.
# =============================================================================

# ---------------------------------------------------------------------------
# Postgres (postgres service)
# These create the database/user and are composed into the backend's
# DATABASE_URL inside docker-compose.yml, so you normally don't set
# DATABASE_URL directly.
# ---------------------------------------------------------------------------
POSTGRES_USER=knightverse
POSTGRES_PASSWORD=knightverse_password
POSTGRES_DB=knightverse_db

# ---------------------------------------------------------------------------
# Backend (backend service, http://localhost:8080)
# ---------------------------------------------------------------------------
# JWT signing secret. The backend panics on missing or known-insecure
# defaults, so the value below is a long, unique dev placeholder. Replace it
# with a strong random value (e.g. `openssl rand -hex 32`) for any shared env.
JWT_SECRET=knightverse_local_dev_jwt_secret_replace_before_production_0123456789abcdef
# Access-token lifetime in seconds (3600 = 1 hour).
JWT_EXPIRATION_SECS=3600
# Comma-separated CORS allow-list. Must include the frontend origin.
ALLOWED_ORIGINS=http://localhost:3000
# Log level for the Rust backend.
RUST_LOG=info,xlmate=debug
# Runtime environment label.
ENVIRONMENT=development
# DATABASE_URL and REDIS_URL are derived in docker-compose.yml from the
# postgres/redis services above. Override only if you point at external stores:
# DATABASE_URL=postgres://knightverse:knightverse_password@postgres:5432/knightverse_db
# REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Frontend (frontend service, http://localhost:3000)
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# changing them requires rebuilding the frontend image (`docker compose build
# frontend`). The browser uses these to reach the backend's host-published
# port.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# Legacy alias kept in sync with NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Agent engines (agent-engines service, ws://localhost:8765)
# CPU Stockfish backend is the default for the local stack (no GPU required).
# ---------------------------------------------------------------------------
# WebSocket server port (host and container).
AGENT_WS_PORT=8765
# Engine backend: stockfish (CPU, bundled in the image) or lc0 (needs weights).
ENGINE_BACKEND=stockfish
# Stockfish tuning (CPU).
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=256

# ---------------------------------------------------------------------------
# Monitoring profile (optional)
# Required only when starting Prometheus/Grafana:
#   docker compose --profile monitoring up -d
# or:
#   docker compose -f backend/docker-compose.monitoring.yml --project-directory backend up -d
#
# A default of "knightverse" is used when unset. Override in production.
# NOTE: grafana maps host port 3000, which collides with the frontend; remap one
# if you run the monitoring profile alongside the frontend.
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=changeme
