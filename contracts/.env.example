# KnightVerse Contracts Environment Configuration
# Copy this file to .env and fill in with your actual values

# Stellar Network Configuration
# Options: testnet, futurenet, public (mainnet)
STELLAR_NETWORK=testnet

# Horizon API URL (for account queries, balances, etc.)
# Testnet: https://horizon-testnet.stellar.org
# Futurenet: https://horizon-futurenet.stellar.org
# Mainnet: https://horizon.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL (for contract simulation, deployment, invocation)
# Testnet: https://soroban-testnet.stellar.org:443
# Futurenet: https://rpc-futurenet.stellar.org:443
# Mainnet: https://soroban.stellar.org:443
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443

# Deployer Account
# The Stellar account alias (from `stellar keys`) used to deploy contracts
# Example: DEPLOYER_ACCOUNT=my-testnet-deployer
DEPLOYER_ACCOUNT=

# Network Passphrase
# Testnet: "Test SDF Network ; September 2015"
# Futurenet: "Test SDF Future Network ; October 2022"
# Mainnet: "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract Deployment Configuration
# Set to "true" to skip contract optimization (faster for local testing)
# SKIP_OPTIMIZE=false

# Target WASM directory (relative to contracts/ root)
# WASM_TARGET_DIR=target/wasm32-unknown-unknown/release