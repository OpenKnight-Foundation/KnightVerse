# =============================================================================
# KnightVerse Frontend — Environment Configuration Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are bundled into the client-side JS.
# Variables without that prefix are server-side only (build scripts, CI, etc.).
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend / Game Server
# Single source of truth: all REST endpoints AND WebSocket URLs are derived from
# this value by lib/api.ts.  The WS base (ws:// or wss://) is computed
# automatically by replacing the http/https scheme.
#
#   Local dev   → http://localhost:8000
#   Staging     → https://api-staging.knightverse.io
#   Production  → https://api.knightverse.io
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# Legacy alias used by a small number of older service files.
# Keep in sync with NEXT_PUBLIC_API_URL unless you have a specific reason
# to point them at different hosts.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# WebSocket Node Discovery (horizontal scaling)
# The WebSocketScalingProvider queries this endpoint to pick the optimal
# game-server node for a given game session.  Falls back to NEXT_PUBLIC_API_URL
# when unset.
#
#   Local dev   → http://localhost:8000/v1/nodes/discovery
#   Staging     → https://api-staging.knightverse.io/v1/nodes/discovery
#   Production  → https://api.knightverse.io/v1/nodes/discovery
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DISCOVERY_URL=http://localhost:8000/v1/nodes/discovery

# -----------------------------------------------------------------------------
# Stellar / Soroban Network
# Controls which Stellar network the wallet context and transaction builder use.
#
#   Testnet passphrase : "Test SDF Network ; September 2015"
#   Mainnet passphrase : "Public Global Stellar Network ; September 2015"
# -----------------------------------------------------------------------------
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org:443
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# -----------------------------------------------------------------------------
# Soroban Smart Contract Addresses
# Replace placeholder values with the actual contract IDs deployed to the
# target network.  All addresses are 56-character Stellar contract IDs (C…).
# -----------------------------------------------------------------------------

# Main game escrow contract — holds wager funds during a match.
NEXT_PUBLIC_CONTRACT_GAME_ESCROW=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ELO registry contract — on-chain ELO rating records.
NEXT_PUBLIC_CONTRACT_ELO_REGISTRY=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAB

# Tournament prize pool contract.
NEXT_PUBLIC_CONTRACT_TOURNAMENT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAC

# -----------------------------------------------------------------------------
# IPFS / Decentralized Storage
# Gateway used for pinned NFT metadata and game archive CIDs.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# -----------------------------------------------------------------------------
# Feature Flags
# A JSON object that controls gradual UI rollouts without a redeploy.
# See context/featureFlagContext.tsx for the full flag schema.
#
# Supported rule types per flag:
#   { "enabled": true }                  — fully on for all users
#   { "enabled": false }                 — fully off for all users
#   { "rollout": 0.25 }                  — 25 % of users (stable per user ID)
#
# Example enabling the new board renderer for 20 % of users and hiding the
# redesigned tournament bracket for everyone:
#
#   NEXT_PUBLIC_FEATURE_FLAGS='{"new_board_renderer":{"rollout":0.20},"new_tournament_bracket":{"enabled":false}}'
#
# Omitting a flag key is equivalent to { "enabled": false }.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FEATURE_FLAGS='{"new_board_renderer":{"enabled":false},"new_tournament_bracket":{"enabled":false}}'

# -----------------------------------------------------------------------------
# Sentry Error Tracking  (client-side)
# DSN is safe to expose publicly; it only allows event ingestion.
# Leave blank to disable Sentry (it is only active when NODE_ENV=production).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Sentry Source Maps Upload  (build-time, server-side — no NEXT_PUBLIC_ prefix)
# Required for readable stack traces in the Sentry dashboard.
# Obtain these from https://sentry.io → Settings → Auth Tokens.
# -----------------------------------------------------------------------------
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=knightverse-frontend

# -----------------------------------------------------------------------------
# Playwright / E2E Tests  (not bundled into the app)
# -----------------------------------------------------------------------------
BASE_URL=http://localhost:3000
