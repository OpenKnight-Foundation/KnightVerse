# KnightVerse Frontend Environment Configuration
# Copy this file to .env.local and fill in with your actual values
# (Next.js loads .env.local automatically; do NOT commit .env.local)

# Backend / Game Server API
# The base URL for REST and WebSocket connections to the backend
# Local dev: http://localhost:8000
# Staging: https://api-staging.knightverse.ai
# Production: https://api.knightverse.ai
NEXT_PUBLIC_API_URL=http://localhost:8000

# Legacy alias (some older services read this)
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Stellar Horizon API
# Testnet: https://horizon-testnet.stellar.org
# Futurenet: https://horizon-futurenet.stellar.org
# Mainnet: https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC Endpoint
# Testnet: https://soroban-testnet.stellar.org:443
# Futurenet: https://rpc-futurenet.stellar.org:443
# Mainnet: https://soroban.stellar.org:443
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org:443

# Stellar Network Passphrase
# Testnet: "Test SDF Network ; September 2015"
# Futurenet: "Test SDF Future Network ; October 2022"
# Mainnet: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar Network (used by Freighter wallet and some UI components)
# Options: testnet, futurenet, public
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# IPFS Gateway for decentralized storage (metadata, avatars, etc.)
# Default: https://gateway.pinata.cloud
# Can use other gateways like https://cloudflare-ipfs.com/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# Sentry DSN for error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL_UI=false